# 이 파일을 복사해서 .env.local 로 만들고 실제 값을 채워 넣으세요.
# .env.local 은 .gitignore 처리되어 git에 올라가지 않습니다.

# next-auth 세션 암호화 키 (필수). 아래 명령으로 생성:
#   npx auth secret
AUTH_SECRET=

# 구글 로그인 - https://console.cloud.google.com (OAuth 클라이언트 ID)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 카카오 로그인 - https://developers.kakao.com (내 애플리케이션 > 카카오 로그인)
# Redirect URI: http://localhost:3000/api/auth/callback/kakao
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# 네이버 로그인 - https://developers.naver.com (애플리케이션 등록 > 네이버 로그인)
# Callback URL: http://localhost:3000/api/auth/callback/naver
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# 이메일 발송 - Gmail SMTP
# 구글 계정 > 보안 > 2단계 인증 활성화 > 앱 비밀번호 생성 (일반 로그인 비밀번호 아님)
GMAIL_USER=
GMAIL_APP_PASSWORD=
